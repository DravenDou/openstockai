# OpenStock AI configuration. Copy to .env (or run `pnpm setup:local`, which also
# generates the secrets and database credentials below). Placeholders only.

# --- Database ---------------------------------------------------------------
# DATABASE_URL is the admin connection, used only for migrations and provisioning.
DATABASE_URL=postgresql://openstockai:change-me@localhost:55432/openstockai?sslmode=disable
POSTGRES_PASSWORD=change-me
# Least-privilege roles (openstock_api_login / openstock_auth_login), generated by setup.
API_DATABASE_PASSWORD=
AUTH_DATABASE_PASSWORD=
API_DATABASE_URL=
AUTH_DATABASE_URL=
API_DB_MAX_CONNS=8
AUTH_DB_MAX_CONNECTIONS=10
# Optional: a disposable database for Go integration tests.
TEST_DATABASE_URL=

# --- Web, API and auth ------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3017
BETTER_AUTH_SECRET=
BETTER_AUTH_JWKS_URL=http://localhost:3017/api/auth/jwks
JWT_ISSUER=http://localhost:3017
JWT_AUDIENCE=openstockai-api
API_BASE_URL=http://127.0.0.1:8087
API_ADDR=127.0.0.1:8087
# Next.js proxies the chat to the Eve agent here.
EVE_BASE_URL=http://127.0.0.1:4273
# Shared secret between web, API and agent.
AGENT_SERVICE_SECRET=

# --- AI provider (server side only, never NEXT_PUBLIC_) ---------------------
DEEPINFRA_API_KEY=
AI_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Per-call and per-turn limits.
AI_MAX_INPUT_TOKENS=65536
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_STEPS_PER_TURN=8
# progressive prepares tools per task; all exposes the full catalog.
AI_TOOL_SELECTION=progressive
# auto uses TOON on uniform pages when it is smaller; json for comparison.
AI_TOOL_RESULT_FORMAT=auto

# --- Published ports (Docker Compose) ---------------------------------------
WEB_PORT=3017
API_PORT=8087
POSTGRES_PORT=55432
