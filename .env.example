# OpenStock AI. Copy to .env and set the LLM variables below; nothing else is required.
# Internal secrets (database passwords, auth and agent secrets) are generated on the first
# `docker compose up` and kept in a Docker volume. Placeholders only; never commit .env.
#
# Without a valid key the app still starts and the assistant shows "AI not configured".

# --- LLM provider (server side only) -----------------------------------------
# LLM_PROVIDER: openai-compatible (Chat Completions, the default) | anthropic | ollama
# Keep exactly ONE preset active, including its LLM_BASE_URL line, and comment out every line
# of the other presets. A leftover LLM_BASE_URL from another preset is rejected for Anthropic.

# DeepInfra (fill in LLM_API_KEY; an empty key leaves the assistant unconfigured)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# OpenRouter
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=<your-openrouter-key>
# LLM_MODEL=<vendor/model-id>

# OpenAI (also vLLM or LM Studio: point LLM_BASE_URL at your server)
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=<your-openai-key>
# LLM_MODEL=<model-id>

# Anthropic (native provider). Keep LLM_BASE_URL unset unless you use a proxy.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=<your-anthropic-key>
# LLM_MODEL=claude-sonnet-5-5

# Ollama, no key. Start it with `docker compose --profile ollama up -d`; the model is pulled
# once. Use a tool-capable model: small local models are much weaker at tool use.
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b

# --- Optional ----------------------------------------------------------------
# USD per million tokens; enables cost estimates in Agent runs.
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# Per-call and per-turn limits.
# AI_MAX_INPUT_TOKENS=65536
# AI_MAX_OUTPUT_TOKENS=2048
# AI_MAX_STEPS_PER_TURN=8
# progressive prepares tools per task; all exposes the full catalog.
# AI_TOOL_SELECTION=progressive
# auto uses TOON on uniform pages when it is smaller; json for comparison.
# AI_TOOL_RESULT_FORMAT=auto

# Host ports, all bound to 127.0.0.1.
# WEB_PORT=3000
# API_PORT=8087
# POSTGRES_PORT=55432
# OLLAMA_PORT=11434
# Public URL of the web app. Set it when you reach the app through another address or a
# reverse proxy (it must match what the browser uses).
# BETTER_AUTH_URL=http://localhost:3000

# MCP server (apps/mcp). MCP_RESOURCE_URL is the public identifier of the MCP endpoint: HTTPS,
# or plain HTTP on localhost only. MCP_SERVICE_SECRET (>= 32 characters) enables the MCP path
# and is generated automatically under Docker Compose; for local development without Docker,
# leaving it unset disables the MCP path.
# MCP_RESOURCE_URL=http://localhost:3100/mcp
# MCP_SERVICE_SECRET=<at-least-32-random-characters>
# MCP_STATE_SECRET (>= 32 characters) signs the approval state of the MCP server; it is also
# generated for you and only the MCP service receives it.
# MCP_STATE_SECRET=<at-least-32-random-characters>
# MCP_PORT=3100
# Host names the MCP server answers to; add your public host name behind a reverse proxy.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1
