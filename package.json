{
  "name": "openstockai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @openstockai/web dev",
    "build": "pnpm --filter @openstockai/web build",
    "start": "pnpm --filter @openstockai/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "compose:up": "docker compose up -d --build",
    "compose:dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build",
    "compose:down": "docker compose down",
    "api:dev": "node scripts/api.mjs",
    "db:migrate": "node scripts/api.mjs --migrate",
    "db:generate": "node scripts/sqlc.mjs",
    "auth:schema": "tsx scripts/generate-auth-schema.ts",
    "api:generate": "openapi-typescript apps/api/openapi.json -o packages/api-client/src/generated.ts && node scripts/generate-api-runtime.mjs",
    "test:go": "node scripts/api.mjs test",
    "test:integration": "node scripts/integration.mjs",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:agent": "pnpm --filter @openstockai/agent test",
    "agent:dev": "pnpm --filter @openstockai/agent dev",
    "agent:build": "pnpm --filter @openstockai/agent build",
    "agent:eval": "pnpm --filter @openstockai/agent eval",
    "test:assistant": "pnpm --filter @openstockai/web test:assistant",
    "test:store": "pnpm --filter @openstockai/web test:store",
    "test:contract": "pnpm --filter @openstockai/web test:contract",
    "test:tooling": "node --test tests/tooling.test.mjs",
    "test:config": "pnpm --filter @openstockai/server test:config",
    "test:auth": "node scripts/auth-check.mjs",
    "owner:reset-password": "node apps/web/scripts/reset-owner-password.mjs",
    "format": "prettier --write apps/web/src/features apps/web/src/shared apps/web/src/shell apps/web/src/server apps/agent/agent/tools apps/agent/agent/lib/schemas.ts packages tests/architecture.test.mjs",
    "format:check": "prettier --check apps/web/src/features apps/web/src/shared apps/web/src/shell apps/web/src/server apps/agent/agent/tools apps/agent/agent/lib/schemas.ts packages tests/architecture.test.mjs",
    "db:provision": "node scripts/api.mjs --provision"
  },
  "devDependencies": {
    "@next/env": "16.4.5",
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eve": "1.5.0",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "^6.0.3"
  }
}
